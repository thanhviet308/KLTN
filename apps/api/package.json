{
  "name": "@chat/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node dist/main.js\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "npm run build && node dist/modules/database/migrate.js",
    "db:show": "npm run build && typeorm migration:show -d dist/modules/database/data-source.js",
    "db:generate": "npm run build && typeorm migration:generate -d dist/modules/database/data-source.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.6",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.6",
    "@nestjs/platform-express": "11.2.6",
    "@nestjs/typeorm": "11.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "tsc-watch": "7.2.1",
    "typescript": "5.9.3"
  }
}
