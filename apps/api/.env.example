NODE_ENV=development
HOST=127.0.0.1
PORT=3000
WEB_ORIGIN=http://localhost:5173
# Enable only behind one trusted reverse proxy; keep the backend port private.
TRUST_PROXY=false
# Replace the placeholder password; URL-encode special characters.
DATABASE_URL=postgresql://realtime_chat_app:CHANGE_ME@127.0.0.1:5432/realtime_chat
# For Neon, use its direct (non-pooler) URL for migrations. Optional locally.
DATABASE_DIRECT_URL=
# Redis and provider credentials will be added with their modules.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME
# Email verification: configure a real SMTP provider; no codes are printed to logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Cloudflare R2 private bucket; keep real credentials in .env only.
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET_NAME=pingpong-storage
R2_REGION=auto
