{
  "name": "realtime-chat",
  "version": "0.1.0",
  "private": true,
  "description": "Web, Android and NestJS backend workspace",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.13.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.6.2",
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all"
  },
  "scripts": {
    "test:call-summary": "npm run build --workspace=@chat/api && node --test apps/api/tests/call-summary.test.cjs apps/web/tests/call-recorder.test.mjs",
    "dev:web": "npm run dev --workspace=@chat/web",
    "db:migrate": "npm run db:migrate --workspace=@chat/api",
    "db:show": "npm run db:show --workspace=@chat/api",
    "dev:api": "npm run dev --workspace=@chat/api",
    "build": "npm run build --workspaces --if-present",
    "start:api": "npm run start --workspace=@chat/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:chat-customization": "npm run build --workspace=@chat/api && node --test apps/api/tests/conversation-customization.test.cjs apps/web/tests/conversation-customization.test.mjs",
    "test:api": "npm run build --workspace=@chat/api && node --test apps/api/tests/*.test.cjs",
    "test:web": "node --test apps/web/tests/*.test.mjs",
    "test": "npm run test:api && npm run test:web && npm test --workspace=@chat/android -- --runInBand",
    "lint": "eslint apps/api/src apps/web/src && npm run lint --workspace=@chat/android",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "check": "npm run lint && npm run typecheck && npm run build && npm test && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "typescript-eslint": "8.71.0"
  }
}
