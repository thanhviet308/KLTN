{
  "name": "realtime-chat",
  "version": "0.1.0",
  "private": true,
  "description": "Web, Android and NestJS backend workspace",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.13.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.6.2",
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all"
  },
  "scripts": {
    "dev:api": "npm run dev --workspace=@chat/api",
    "build": "npm run build --workspaces --if-present",
    "start:api": "npm run start --workspace=@chat/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint apps/api/src",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "check": "npm run lint && npm run typecheck && npm run build && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "typescript-eslint": "8.71.0"
  }
}
